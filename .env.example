# Copy this file to .env and fill in the values below.
# Keep comments on their own lines; inline comments after a value may end up
# being part of the value.

# Database credentials. They can be anything, but do not change them once
# the database has been created.
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_ROOT_PASSWORD=

# OAuth 2.0 client key and secret, as issued by
# https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration
METAWIKI_KEY=
METAWIKI_SECRET=

# URL where the backend is reachable, without a trailing slash and without /api.
# For local development, use http://localhost:8070
BACKEND_URL=

# Default frontend language. Supported values: cs-CZ, en-US
DEFAULT_LOCALE=

# TEMPORARY: comma-separated list of global user IDs (numeric central IDs)
# of people allowed to log in.
TEMP_SUB=
